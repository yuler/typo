---
import Showcases from '@/components/Showcases.astro'
import { getLocalizedPath } from '@/lib/i18n'

const { locale, tr } = Astro.locals
---

<section class="pb-10 pt-8 sm:pb-16 sm:pt-10">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col items-center gap-8 text-center sm:gap-10">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-yellow-200 bg-yellow-50/70 px-3 py-1 text-xs font-medium text-yellow-700 dark:border-yellow-700/50 dark:bg-yellow-900/20 dark:text-yellow-200"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-yellow-400 dark:bg-yellow-300" aria-hidden></span>
        {tr('hero.badge')}
      </div>
      <div class="space-y-4">
        <h1 class="text-balance text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50">
          {tr('hero.title')}
        </h1>
        <p class="mx-auto max-w-2xl text-pretty text-lg text-zinc-600 dark:text-zinc-400">
          {tr('hero.description')}
        </p>
      </div>
    </div>
  </div>

  <div class="relative mt-10 w-full sm:mt-12 lg:mt-14">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:max-w-352 lg:px-8 xl:px-10">
      <Showcases />
    </div>
  </div>

  <div class="mx-auto mt-8 flex max-w-5xl flex-wrap justify-center gap-3 px-4 sm:mt-10 sm:px-6">
    <a
      href={getLocalizedPath('/downloads', locale)}
      class="inline-flex h-10 items-center justify-center rounded-lg bg-zinc-900 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200"
    >
      {tr('demo.download_free')}
    </a>
    <button
      type="button"
      data-intro-open
      class="inline-flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-zinc-300 px-5 text-sm font-semibold text-zinc-900 transition hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-100 dark:hover:bg-zinc-800"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.92-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"></path>
      </svg>
      {tr('hero.watch')}
    </button>
  </div>

  <dialog
    data-intro-dialog
    class="m-auto max-h-[90vh] max-w-[90vw] overflow-visible rounded-2xl border-none bg-transparent p-0 shadow-2xl outline-none backdrop:bg-black/70"
  >
    <video
      src="/intro.mp4"
      poster="/intro-poster.jpg"
      class="block max-h-[85vh] w-[90vw] max-w-7xl rounded-2xl bg-black"
      controls
      playsinline
      preload="none"
    >
      {tr('hero.video_fallback')}
    </video>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-intro-dialog]')
  const video = dialog?.querySelector('video')

  document.querySelector('[data-intro-open]')?.addEventListener('click', () => {
    dialog?.showModal()
    void video?.play()
  })
  dialog?.addEventListener('click', (event) => event.target === dialog && dialog.close())
  dialog?.addEventListener('close', () => video?.pause())
</script>
