{
  "name": "@typo/intro-video",
  "type": "module",
  "version": "1.5.4",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./demo": "./src/demo/TypoIntroDemo.vue",
    "./components": "./src/components/index.ts",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build",
    "studio": "node scripts/studio.mjs",
    "studio:once": "node scripts/studio.mjs --once",
    "check": "pnpm build && npx --yes hyperframes@0.6.40 lint dist/capture/index.html && npx --yes hyperframes@0.6.40 validate dist/capture/index.html",
    "render": "pnpm build && cd dist/capture && npx --yes hyperframes@0.6.40 render --output ../typo-intro.mp4"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lucide-vue-next": "^0.516.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
